rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated and in admin allowlist or has admin claim
    function isAdmin() {
      return request.auth != null && 
        (
          request.auth.token.admin == true ||
          request.auth.token.email.matches('.*@eyecareoptical[.]com') ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Products Collection
    // Public visitors can only READ ACTIVE products.
    // Authorized Admins can read all, create, update, and delete products.
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin() && 
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.sellingPrice is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Offers Collection (Diwali & Dussehra offers)
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries / Appointments Collection
    // Public can submit an enquiry, only Admins can read, update, or delete.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.name is string && 
                       request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    // Admins metadata collection
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only manageable via Firebase Admin SDK / Console
    }
  }
}
