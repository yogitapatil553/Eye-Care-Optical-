# Auto-detect text files and perform LF normalization on checkout
* text=auto

# Web & Source Files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.rules text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
